{
  "name": "lastseat",
  "private": true,
  "version": "1.0.0",
  "description": "Race-proof team formation for hackathons: exactly one person gets the last seat.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "test:race": "npm run test:race -w server",
    "test:chaos": "npm run test:chaos -w server",
    "seed": "npm run seed -w server",
    "verify": "npm run verify -w server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
