# Copy to .env for local development. Every value has a safe default for `npm run dev`.

# MongoDB must be a replica set (transactions + change streams). Atlas free tier is one.
MONGODB_URI=mongodb://127.0.0.1:27017/lastseat?replicaSet=rs0
PORT=4000
NODE_ENV=development

# Set in production so cookies are marked Secure and the proxy's client IP is trusted.
# TRUST_PROXY=1

# Optional bearer token protecting GET /metrics. Leave empty to keep it open (dev only).
# METRICS_TOKEN=
